# Site
# SITE_URL: origem que responde de verdade, com protocolo e sem barra final.
# É daqui que saem as canônicas, o preview social e os links que o agente manda.
NEXT_PUBLIC_SITE_URL=
# WHATSAPP_NUMBER: número real do atendimento, só dígitos (55 + DDD + número).
# Número de exemplo é recusado em runtime — os botões somem em vez de levar
# a família para um contato que não existe.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Funil próprio em /equipe/metricas. O telefone e o cookie viram um código
# irreversível com este segredo. Vazio: usa WHATSAPP_APP_SECRET. Sem nenhum dos
# dois, o funil não grava. Trocar o valor zera a identidade de quem já passou.
METRICA_SALT=

# Supabase (banco + conta do usuário + fotos)
# Settings > API Keys. Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Agente do WhatsApp: roda sem cookie, então precisa da chave secreta.
# NUNCA prefixar com NEXT_PUBLIC_ (vazaria no bundle do navegador).
SUPABASE_SERVICE_ROLE_KEY=

# Login por OTP no WhatsApp (Meta Cloud API)
# Segredo gerado em Authentication > Hooks > Send SMS (formato v1,whsec_...)
SEND_SMS_HOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=codigo_acesso
WHATSAPP_OTP_LOCALE=pt_BR

# Webhook do agente (Meta > App > WhatsApp > Configuration)
# VERIFY_TOKEN: você inventa e repete no painel. APP_SECRET: Settings > Basic.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Eco de diagnóstico ao conectar o número. Deixar vazio em produção.
WHATSAPP_AGENTE_ECO=

# Template de alerta "surgiu peça" (fora da janela de 24h). Categoria UTILITY.
# Corpo com 2 variáveis: {{1}} = nome da peça, {{2}} = tamanho.
# Sem isto, o aviso só sai se a pessoa falou com o número nas últimas 24h.
WHATSAPP_ALERTA_TEMPLATE=

# Equipe de /equipe/reservas. Em cada lista, telefone (55 + DDD + número) ou
# e-mail, separados por vírgula.
# Administração faz tudo. Produção muda o status e vê os totais.
# Balcão consulta e ajusta tamanho enquanto a reserva ainda pode mudar.
# EQUIPE_TELEFONES e EQUIPE_EMAILS continuam valendo como administração.
EQUIPE_ADMIN=
EQUIPE_PRODUCAO=
EQUIPE_BALCAO=
EQUIPE_TELEFONES=
EQUIPE_EMAILS=