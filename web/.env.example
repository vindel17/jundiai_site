# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase (banco + conta do usuário + fotos)
# Settings > API Keys. Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Agente do WhatsApp: roda sem cookie, então precisa da chave secreta.
# NUNCA prefixar com NEXT_PUBLIC_ (vazaria no bundle do navegador).
SUPABASE_SERVICE_ROLE_KEY=

# Login por OTP no WhatsApp (Meta Cloud API)
# Segredo gerado em Authentication > Hooks > Send SMS (formato v1,whsec_...)
SEND_SMS_HOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=codigo_acesso
WHATSAPP_OTP_LOCALE=pt_BR

# Webhook do agente (Meta > App > WhatsApp > Configuration)
# VERIFY_TOKEN: você inventa e repete no painel. APP_SECRET: Settings > Basic.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Eco de diagnóstico ao conectar o número. Deixar vazio em produção.
WHATSAPP_AGENTE_ECO=

# Template de alerta "surgiu peça" (fora da janela de 24h). Categoria UTILITY.
# Corpo com 2 variáveis: {{1}} = nome da peça, {{2}} = tamanho.
# Sem isto, o aviso só sai se a pessoa falou com o número nas últimas 24h.
WHATSAPP_ALERTA_TEMPLATE=

# Google Sheets CRM
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use \n para quebras de linha da chave privada
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
